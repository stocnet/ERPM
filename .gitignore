# History files
.Rhistory
.Rapp.history

# Session data files
.RData
.RSession

# Example code generated during package build
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio user files
.Rproj.user/

# Generated vignettes
vignettes/*.html
vignettes/*.pdf
vignettes/*.tex
vignettes/figure/
vignettes/cache/

# OAuth2 token (httr)
.httr-oauth

# knitr and R Markdown cache directories
/*_cache/
/cache/

# Temporary files created by R Markdown
*.utf8.md
*.knit.md

# Prerequisites
*.d

