*.o
*.ko
*.obj
*.elf

# Linker output files
*.ilk
*.map
*.exp

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (including Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.gdb_history

# Kernel module build artifacts
*.mod*
*.cmd
modules.order
Module.symvers
Mkfile.old
dkms.conf

# Patch and reject files
*.orig
*.rej

# Backup files
*~
*.bak
.Rproj.user

# Other user-specific files
.Ruserdata
ERPM.Rproj
docs

# JSON files (local debugging)
*.json

# macOS hidden files
*.DS_Store

# Log files
*.log

# Ignore everything under documentation/dev
documentation/dev/**

# Do not ignore directories themselves (required so file-level rules apply)
!documentation/dev/
!documentation/dev/**/

# Do not ignore Avancement.pdf files in any subdirectory
!documentation/dev/**/Avancement.pdf

# Generated dump of ERPM source files
dump_erpm_files.*